---
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="bg-bg text-text font-sans">
    <slot />
    <SpeedInsights />
    <script>
      /*
       * Blokada menu kontekstowego na zdjęciach. DETERENT, nie
       * zabezpieczenie — patrz CLAUDE.md. Zdejmuje najprostszą ścieżkę
       * („Zapisz obraz jako"), nie rusza reszty strony, żeby kopiowanie
       * tekstu i menu przeglądarki nadal działały normalnie.
       */
      document.addEventListener('contextmenu', (event) => {
        if (event.target instanceof HTMLImageElement) event.preventDefault();
      });
    </script>
  </body>
</html>
