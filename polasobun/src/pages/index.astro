---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery';
import { projects } from '../content/projects';

/**
 * Okładki. import.meta.glob z eager: true — ścieżka jako string NIE zostałaby
 * zoptymalizowana i wysypałaby się na produkcji.
 */
const covers = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*/01.jpg',
  { eager: true },
);

function cover(slug: string): ImageMetadata {
  const mod = covers[`../assets/photos/${slug}/01.jpg`];
  if (!mod) throw new Error(`Brak okładki 01.jpg dla slugu "${slug}"`);
  return mod.default;
}

/** Kafel 4/5 — kadr powstaje automatycznie (Astro 6+ przycina domyślnie). */
const COVER_WIDTH = 800;
const COVER_HEIGHT = 1000;

/** Pierwsze sześć okładek ładujemy od razu, resztę leniwie. */
const EAGER_COUNT = 6;
---

<Base title="Pola Sobuń">
  <Gallery client:load wordmark="Pola Sobuń">
    {
      projects.map((project, index) => (
        <a
          href={`/work/${project.slug}`}
          data-cat={project.tags.join(' ')}
          class="bg-surface"
        >
          <Picture
            src={cover(project.slug)}
            formats={['avif', 'webp']}
            width={COVER_WIDTH}
            height={COVER_HEIGHT}
            alt={project.title}
            loading={index < EAGER_COUNT ? 'eager' : 'lazy'}
            class="aspect-tile block w-full object-cover"
          />
          <span class="text-on-dark-muted text-label block font-medium uppercase leading-none tracking-meta px-card py-tight">
            {project.title}
          </span>
        </a>
      ))
    }
  </Gallery>
</Base>
