---
import { getImage } from 'astro:assets';
import sharp from 'sharp';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery';
import Intro from '../components/Intro';
import { projects } from '../content/projects';

/**
 * Minimalna deklaracja `process`, żeby nie dokładać @types/node tylko dla
 * jednej metody. `process` istnieje realnie w Node w trakcie builda — brak
 * typu jest jedynie brakiem deklaracji, nie brakiem środowiska.
 */
declare const process: { cwd(): string };

/**
 * Wszystkie zdjęcia. import.meta.glob z eager: true — ścieżka jako string
 * NIE zostałaby zoptymalizowana i wysypałaby się na produkcji.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*/*.jpg',
  { eager: true },
);

/**
 * Zdjęcia pogrupowane po slugu, w kolejności nazw plików.
 *
 * `fsPath` niesie absolutną ścieżkę pliku źródłowego. ImageMetadata w tej
 * wersji Astro (7.2.7) NIE ma pola `fsPath` — sprawdzone przez
 * console.log(tiles[0].img) podczas builda, ma tylko
 * { src, width, height, format }, a samo `src` w dev to URL `/@fs/...`
 * z query stringiem.
 *
 * `import.meta.url` też zawodzi: podczas `astro build` strona renderuje się
 * z osobnego bundla w `dist/.prerender/`, więc `import.meta.url` wskazuje
 * tam, nie na oryginalny plik źródłowy — ścieżka wyliczona względem niego
 * trafiała w nieistniejący `dist/.prerender/assets/photos/...` (zmierzone,
 * build wywalał się na "Input file is missing"). `process.cwd()` podczas
 * builda to zawsze katalog projektu (skąd wystartował `npm run build`),
 * niezależnie od tego, gdzie Rollup poukładał skompilowane chunki — więc
 * ścieżka budowana od cwd + `slug`/`name` jest stabilna.
 */
const bySlug = new Map<string, { name: string; img: ImageMetadata; fsPath: string }[]>();
for (const [path, mod] of Object.entries(files)) {
  const match = /\/photos\/([^/]+)\/([^/]+)$/.exec(path);
  if (!match) continue;
  const [, slug, name] = match as unknown as [string, string, string];
  const list = bySlug.get(slug) ?? [];
  const fsPath = `${process.cwd()}/src/assets/photos/${slug}/${name}`;
  list.push({ name, img: mod.default, fsPath });
  bySlug.set(slug, list);
}
for (const list of bySlug.values()) list.sort((a, b) => a.name.localeCompare(b.name));

interface Tile {
  key: string;
  img: ImageMetadata;
  /** Absolutna ścieżka pliku źródłowego — potrzebna tylko dla kafla 0. */
  fsPath: string;
  /** Widoki, w których kafel jest widoczny — trafia do data-cat. */
  cats: string;
  alt: string;
  href?: string;
  caption?: string;
}

const tiles: Tile[] = [];

/**
 * 1. Kafle zdjęć — ALL, PORTRAITS, FOOD. Bez podpisów i bez linków.
 *    `commercial` celowo odfiltrowane: zakładka COMMERCIAL pokazuje
 *    okładki kampanii, nie pojedyncze zdjęcia.
 *
 *    DWA PRZEBIEGI, w tej kolejności:
 *
 *    a) kadry z pola `featured` — wybrane ręcznie z arkuszy stykowych,
 *       round-robinem po sesjach. Runda zerowa to najmocniejszy kadr
 *       KAŻDEJ sesji, więc pierwszy ekran ALL to same petardy, każda
 *       z innej sesji. To one dostają eager i stagger wejścia.
 *
 *    b) reszta zdjęć — bez tagu `all`, więc niewidoczne w ALL, ale nadal
 *       obecne w PORTRAITS i FOOD. Zdjęcie, które nie ma ani `featured`,
 *       ani tagu portraits/food, nie trafiłoby do żadnej zakładki —
 *       jest pomijane i zostaje na stronie swojej kampanii.
 *
 *    Okładka (01.jpg) nie wchodzi do ALL: pokazuje ją kafel kampanii
 *    w COMMERCIAL, więc w ALL witałaby drugi raz. Kolekcje (_portraits,
 *    _food) nie mają kafla kampanii, więc u nich okładka może zostać.
 */
const kolejki = projects.map((project) => {
  const wszystkie = bySlug.get(project.slug) ?? [];
  const wybrane = (project.featured ?? [])
    .map((nazwa) => wszystkie.find((z) => z.name === nazwa))
    .filter((z): z is (typeof wszystkie)[number] => z !== undefined);
  const wybraneNazwy = new Set(wybrane.map((z) => z.name));
  const reszta = wszystkie.filter(
    (z) => !wybraneNazwy.has(z.name) && (project.collection || z.name !== '01.jpg'),
  );
  return { project, wybrane, reszta };
});

/** a) featured, round-robinem — najmocniejsze kadry na pierwszym ekranie. */
const najwiecejWybranych = Math.max(...kolejki.map((k) => k.wybrane.length));
for (let runda = 0; runda < najwiecejWybranych; runda++) {
  for (const { project, wybrane } of kolejki) {
    const zdjecie = wybrane[runda];
    if (!zdjecie) continue;
    const widoki: string[] = ['all', ...project.tags.filter((tag) => tag !== 'commercial')];
    tiles.push({
      key: `${project.slug}/${zdjecie.name}`,
      img: zdjecie.img,
      fsPath: zdjecie.fsPath,
      cats: widoki.join(' '),
      alt: project.title,
    });
  }
}

/** b) reszta — tylko dla PORTRAITS i FOOD. */
const najdluzszaReszta = Math.max(...kolejki.map((k) => k.reszta.length));
for (let runda = 0; runda < najdluzszaReszta; runda++) {
  for (const { project, reszta } of kolejki) {
    const zdjecie = reszta[runda];
    if (!zdjecie) continue;
    const widoki: string[] = project.tags.filter((tag) => tag !== 'commercial');
    if (!widoki.length) continue;
    tiles.push({
      key: `${project.slug}/${zdjecie.name}`,
      img: zdjecie.img,
      fsPath: zdjecie.fsPath,
      cats: widoki.join(' '),
      alt: project.title,
    });
  }
}

/** 2. Kafle kampanii — tylko COMMERCIAL. Okładka + podpis + link. */
for (const project of projects) {
  if (project.collection) continue;
  const cover = bySlug.get(project.slug)?.[0];
  if (!cover) throw new Error(`Brak zdjęć dla slugu "${project.slug}"`);
  tiles.push({
    key: `cover/${project.slug}`,
    img: cover.img,
    fsPath: cover.fsPath,
    cats: 'commercial',
    alt: project.title,
    href: `/work/${project.slug}`,
    caption: project.title,
  });
}

/**
 * Animacja wejścia — JEDEN kadr. Mocno graficzny i wysokokontrastowy:
 * split-flap rozbija zdjęcie na kafelki, więc czytelna plama koloru
 * działa lepiej niż subtelny portret.
 */
const INTRO = { slug: 'rimmel', photo: '01.jpg', focusY: 30 };

const introEntry = bySlug.get(INTRO.slug)?.find((p) => p.name === INTRO.photo);
if (!introEntry) {
  throw new Error(`Brak zdjęcia ${INTRO.slug}/${INTRO.photo} do animacji wejścia`);
}
/*
 * Dwa warianty. Wcześniej szło jedno 1920 px i ważyło 525 kB — największy
 * pojedynczy zasób strony, serwowany także na ekran 412 px szerokości.
 * Canvas nigdy nie jest większy niż okno, a split-flap tnie kadr na kafelki.
 * Canvas potrzebuje URL-a, ale zdjęcie i tak przechodzi przez astro:assets.
 */
const [introMaly, introDuzy] = await Promise.all([
  getImage({ src: introEntry.img, width: 900, format: 'webp' }),
  getImage({ src: introEntry.img, width: 1800, format: 'webp' }),
]);
const introImage = { maly: introMaly.src, duzy: introDuzy.src, focusY: INTRO.focusY };

/**
 * Dwa poziomy jakości. Powód jest w pomiarze, nie w wadze: na łączu
 * o opóźnieniu 576 ms transfer ogranicza LICZBA OBROTÓW, nie bajty.
 * Kafel 1000 px potrzebuje ~4 obrotów (~2,3 s), kafel 400 px mieści się
 * w jednym–dwóch. Dlatego HTML niesie lekki, a ostry dochodzi później.
 *
 * Proporcja obu musi być identyczna (4:5), inaczej podmiana przesunie
 * układ i CLS przestanie być zerowy.
 *
 * 440 px, a nie 400 — i to NIE jest zaokrąglenie w górę. LCP raportuje
 * MNIEJSZY z dwóch obszarów: naturalny albo wyświetlany. Kafel zajmuje
 * 412 px na stanowisku i 430 px na iPhonie, więc kadr 400 px liczył się
 * jako 400x500 = 200 000, a ostry jako pełne 412x515 = 212 180. Podmiana
 * była przez to WIĘKSZYM malowaniem i wystawiała nowy, późny kandydat
 * LCP — zmierzone 6288 ms zamiast 3564 ms. Te 5,7% obszaru kosztowały
 * 4,7 sekundy metryki.
 *
 * Kadr lekki musi więc być NIE MNIEJSZY niż miejsce, które wypełnia.
 * 440 px pokrywa 412 i 430 z zapasem. Ostrzeżenie: siatka jest
 * jednokolumnowa do 639 px, więc urządzenie o szerokości 440-639 px
 * odtworzy ten sam problem. Wśród realnych telefonów takich nie ma
 * (najszerszy to 430), ale gdyby się pojawiły — trzeba podnieść 440.
 */
const LEKKI = { width: 440, height: 550 };
const OSTRY = { width: 1000, height: 1250 };

/**
 * Warianty liczone raz, w kolejności zgodnej z `tiles` — markup sięga
 * po indeks, więc obie tablice muszą pozostać równoległe.
 */
const warianty = await Promise.all(
  tiles.map(async (tile) => {
    const [lekki, ostry] = await Promise.all([
      getImage({ src: tile.img, ...LEKKI, format: 'webp' }),
      getImage({ src: tile.img, ...OSTRY, format: 'webp' }),
    ]);
    return { lekki: lekki.src, ostry: ostry.src };
  }),
);

/**
 * Pierwszy kafel wprost w dokumencie. Ten sam zabieg, co
 * inlineStylesheets: 'always' — zdejmuje z niego cały obrót sieci.
 *
 * Kosztem jest grubszy dokument, który sam leży na ścieżce krytycznej,
 * a base64 puchnie o 33% i nie kompresuje się dalej. Zabieg zostaje
 * TYLKO dlatego, że pomiar potwierdził zysk na LCP bez straty na FCP.
 *
 * Kodujemy własnym sharpem, bo plik z getImage() powstaje dopiero na
 * końcu builda i tutaj jeszcze nie istnieje. Parametry muszą zgadzać się
 * z wariantem lekkim, inaczej dokument niósłby inny kadr niż reszta siatki.
 */
const bufor = await sharp(tiles[0].fsPath)
  .resize(LEKKI.width, LEKKI.height, { fit: 'cover' })
  .webp({ quality: 62 })
  .toBuffer();
const pierwszyKafelData = `data:image/webp;base64,${bufor.toString('base64')}`;

/**
 * Ile kafli ładujemy od razu. Przy JEDNEJ kolumnie na telefonie widać
 * około dwóch, więc ósemka dobrana pod dwie kolumny była tu nadmiarem:
 * osiem kafli to na start dwa razy więcej bajtów, niż widać.
 * Resztę i tak dociąga obserwator paczek, który rusza po zdarzeniu load.
 * Pierwszy kafel ma fetchpriority="high" i to on decyduje o LCP.
 */
const EAGER_COUNT = 4;
---

<Base title="Pola Sobuń">
  <Intro client:load image={introImage} />

  <Gallery client:load wordmark="Pola Sobuń">
    {
      tiles.map((tile, index) => {
        // width/height opisują wariant OSTRY, nie ten w src: docelowym stanem
        // kafla jest wersja ostra, a obie mają tę samą proporcję 4:5, więc
        // przeglądarka i tak dostaje poprawny format do rezerwacji miejsca.
        // Rozmiar na ekranie i tak narzuca CSS (aspect-tile + w-full).
        const img = (
          <img
            src={index === 0 ? pierwszyKafelData : warianty[index].lekki}
            data-pelny={warianty[index].ostry}
            width={OSTRY.width}
            height={OSTRY.height}
            alt={tile.alt}
            loading={index < EAGER_COUNT ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
            class="aspect-tile block w-full object-cover"
          />
        );

        return tile.href ? (
          <a href={tile.href} data-cat={tile.cats} class="bg-surface overflow-hidden">
            {img}
            <span class="text-on-dark-muted text-label block font-medium uppercase leading-none tracking-meta px-card py-tight">
              {tile.caption}
            </span>
          </a>
        ) : (
          <div data-cat={tile.cats} class="bg-surface overflow-hidden">{img}</div>
        );
      })
    }
  </Gallery>
</Base>
